<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.music.ExerciseFragment">

    <FrameLayout
        android:id="@+id/RythmExercise"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/rhythmLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Rhythm Exercise"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/rhythmYoutubePlayer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Choose the matching rhythm:"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rhythmAnswerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/rhythmCard1"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp">

                        <ImageView
                            android:id="@+id/rhythmImage1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/rhythmCard2"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp">

                        <ImageView
                            android:id="@+id/rhythmImage2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rhythmSubmitBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Submit Answer"
                android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/HarmonyExercise"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/harmonyLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:id="@+id/harmonyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Harmony Exercise"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- YouTube Video -->
            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/harmonyYoutubePlayer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="20dp" />

            <!-- Question -->
            <TextView
                android:id="@+id/harmonyQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Choose the correct harmony:"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Horizontal Answer Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/harmonyAnswerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Answer Card 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/answerCard1"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/answerImage1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Answer Card 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/answerCard2"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/answerImage2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Answer Card 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/answerCard3"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/answerImage3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/harmonySubmitBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Submit Answer"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ChordExercise"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/chordsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Chord Exercise"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/chordsYoutubePlayer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Select the correct chord:"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chordsAnswerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chordsCard1"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp">

                        <ImageView
                            android:id="@+id/chordsImage1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chordsCard2"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp">

                        <ImageView
                            android:id="@+id/chordsImage2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chordsSubmitBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Submit Answer"
                android:textAllCaps="false" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/InstrumentsExercise"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/instrumentsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instrument Exercise"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/instrumentsYoutubePlayer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Identify the instrument:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/instrumentsAnswerContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/instrumentsCard1"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp">

                        <ImageView
                            android:id="@+id/instrumentsImage1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/instrumentsCard2"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="18dp">

                        <ImageView
                            android:id="@+id/instrumentsImage2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/instrumentsSubmitBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Submit Answer"
                android:textAllCaps="false"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>